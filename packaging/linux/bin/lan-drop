#!/bin/sh
# LAN-Drop 启动器（Linux）
#
# 做四件事：定位程序目录 → 挑一个够新的 node → 载入环境文件 → 前台运行服务端。
# systemd 直接跑本脚本（ExecStart），手动调试也建议用它，保证环境与自启时一致。
#
# 环境文件（KEY=VALUE，`#` 注释）默认读 ~/.config/lan-drop/env（或 $XDG_CONFIG_HOME）。
# 可用 LAN_DROP_ENV_FILE 指定别的路径；install.sh 会生成一份带注释的样例。
set -eu

SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROGRAM_DIR=$(CDPATH= cd -- "$SELF_DIR/.." && pwd)
SERVER_JS="$PROGRAM_DIR/app/server/server.js"

# 优先用包内自带的 node（便携包可能带），否则用 PATH 里的
NODE_BIN=""
if [ -x "$PROGRAM_DIR/node/node" ]; then
  NODE_BIN="$PROGRAM_DIR/node/node"
elif command -v node >/dev/null 2>&1; then
  NODE_BIN=$(command -v node)
fi

if [ -z "$NODE_BIN" ]; then
  echo "找不到 node：请安装 Node 24+ （或把便携 node 放在 $PROGRAM_DIR/node/node），然后重试。" >&2
  exit 127
fi

# 服务端用到 node:sqlite，Node 24 以下没有这个内建模块，必须提前拦住（否则报错难懂）
NODE_MAJOR=$("$NODE_BIN" -e 'process.stdout.write(process.versions.node.split(".")[0])' 2>/dev/null || echo 0)
if [ "$NODE_MAJOR" -lt 24 ] 2>/dev/null; then
  echo "node 版本过低（v$("$NODE_BIN" -v 2>/dev/null || echo '?')）：服务端需要 Node 24+（node:sqlite）。" >&2
  exit 1
fi

ENV_FILE="${LAN_DROP_ENV_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/lan-drop/env}"
if [ -f "$ENV_FILE" ]; then
  # set -a 让文件里的 KEY=VALUE 自动导出；文件由 install.sh 生成，是纯 POSIX 赋值语法
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
fi

exec "$NODE_BIN" "$SERVER_JS" "$@"

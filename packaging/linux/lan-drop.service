[Unit]
Description=LAN-Drop 局域网文件与文字传输服务端
Documentation=https://github.com/illagerCPR/LAN-Drop
# 手机要连得上，等网络就绪再起，省得开局 bind 失败
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# install.sh 会替换下面两行为实际路径（模板占位符见 __EXEC__ / __ENV_FILE__）
ExecStart=__EXEC__
EnvironmentFile=-__ENV_FILE__
Restart=on-failure
RestartSec=2
# 数据目录由 XDG 决定（~/.local/share/lan-drop），与程序目录分离，升级不影响数据
# 不设 WorkingDirectory：程序目录可能只读，服务端不依赖当前目录

[Install]
WantedBy=default.target

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LAN-Drop",
  "mainBinaryName": "LAN-Drop",
  "version": "0.2.1",
  "identifier": "io.github.illagercpr.landrop.desktop",
  "build": {
    "frontendDist": "./resources/web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "illagerCPR",
    "category": "Utility",
    "shortDescription": "局域网文件与文字互传",
    "longDescription": "LAN-Drop PC 常驻端：托盘内常驻，以 sidecar 方式承载局域网文件与文字传输服务端，控制台在浏览器打开。",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/server/server.js": "server/server.js",
      "resources/web/dist": "web/dist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}

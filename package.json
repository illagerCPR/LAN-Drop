{
  "name": "lan-drop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "局域网文件与文字传输工具，替代已下线的 Edge Drop",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @lan-drop/server dev",
    "start": "pnpm --filter @lan-drop/server start",
    "typecheck": "pnpm -r typecheck",
    "web:dev": "pnpm --filter @lan-drop/web dev",
    "web:build": "pnpm --filter @lan-drop/web build",
    "bundle": "node scripts/package.mjs --target stage",
    "package:win": "node scripts/package.mjs --target win",
    "package:linux": "node scripts/package.mjs --target linux",
    "package:all": "node scripts/package.mjs --target all",
    "verify:package": "node scripts/verify-package.mjs --target linux",
    "fix:ps1-bom": "node scripts/fix-ps1-bom.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}

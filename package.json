{
  "name": "lan-drop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "局域网文件与文字传输工具，替代已下线的 Edge Drop",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @lan-drop/server dev",
    "start": "pnpm --filter @lan-drop/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "node scripts/verify-all.mjs",
    "web:dev": "pnpm --filter @lan-drop/web dev",
    "web:build": "pnpm --filter @lan-drop/web build",
    "desktop:resources": "node apps/desktop/scripts/prepare-resources.mjs",
    "desktop:icon": "node apps/desktop/scripts/make-icon.mjs",
    "fix:ps1-bom": "node scripts/fix-ps1-bom.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
